# ---------------------------------------------------------------------------
# Copy this file to .env and adjust the values.
# ---------------------------------------------------------------------------
SECRET_KEY=PQ3OpVKhhAJfMA8dfHhdeIhar0fzYevRizoAFpgi8uQ-B7bhf-jsyRCvZ2V9nJldwmU
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development
TIME_ZONE=Asia/Tashkent

# Base URL of this site (used to build absolute links inside e-mails, e.g. invitations)
SITE_URL=http://127.0.0.1:8000

# Database ------------------------------------------------------------------
# Option A: PostgreSQL via separate variables (works with docker compose)
DB_NAME=teamflow
DB_USER=teamflow
DB_PASSWORD=teamflow
DB_HOST=db
DB_PORT=5432
# Option B: a single URL (used only when DB_NAME is empty)
# DATABASE_URL=postgres://teamflow:teamflow@localhost:5432/teamflow
# If neither is set the project falls back to a local SQLite file.

# Redis ---------------------------------------------------------------------
# Used for cache, WebSocket channel layer and Celery broker.
# Leave empty to run locally without Redis (in-memory cache, tasks run inline).
REDIS_URL=redis://localhost:6379/0

# CSRF (only needed if the site is served from more than one origin/domain)
CSRF_TRUSTED_ORIGINS=

# E-mail --------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=sardorx118@gmail.com
EMAIL_HOST_PASSWORD=sardor2012pk
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=TeamFlow <sardorx118@gmail.com>
